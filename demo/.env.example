# Copy to .env and enter your own values. Never commit .env.
# Direct OpenAI: use an OpenAI key. For 9router: use its dashboard API key.
OPENAI_API_KEY=
# Direct OpenAI default; replace with your router's API base URL when using 9router.
# Local 9router example: http://127.0.0.1:20128/v1
OPENAI_BASE_URL=https://api.openai.com/v1
# Exact model ID from the provider/router; must support tool calling.
FLIGHT_MODEL=gpt-4.1-mini
